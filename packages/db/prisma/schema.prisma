// CAL ACE Nursing Academy — Online CEU LMS
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DomainKind {
  PRIMARY
  CUSTOM
  REDIRECT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CredentialStatus {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
}

enum ProviderApprovalStatus {
  PENDING
  APPROVED
  EXPIRED
  REVOKED
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ContentPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaAssetType {
  VIDEO
  AUDIO
  DOCUMENT
  IMAGE
  SCORM
  OTHER
}

enum MediaAssetStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  MATCHING
}

enum AssessmentKind {
  QUIZ
  FINAL_EXAM
  SURVEY
  PRACTICE
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  WITHDRAWN
  EXPIRED
  /// Legacy: superseded by REQUIRES_RESET (kept for existing rows).
  REQUIRES_REPURCHASE
  /// Learner used all included course attempts; must restart course from beginning.
  REQUIRES_RESET
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  PASSED
  FAILED
  VOIDED
}

enum CompletionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateStatus {
  PENDING
  ISSUED
  REVOKED
  EXPIRED
}

enum VerificationTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TranscriptEntryType {
  COMPLETION
  TRANSFER
  ADJUSTMENT
  MANUAL
}

enum RenewalPeriodStatus {
  UPCOMING
  ACTIVE
  LAPSED
  COMPLETED
}

enum ComplianceSnapshotStatus {
  COMPLIANT
  AT_RISK
  NON_COMPLIANT
  UNKNOWN
}

enum AiGenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiGenerationJobType {
  COURSE_OUTLINE
  LESSON_CONTENT
  ASSESSMENT
  MEDIA_CAPTION
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  REWARDED
}

enum ReferralRewardReason {
  REFERRAL_CONVERSION
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationCategory {
  COURSE_PROGRESS
  COMPLIANCE
  ACHIEVEMENT
  ANNOUNCEMENT
  SYSTEM
  RETENTION_PLACEHOLDER
  COMMUNITY_PLACEHOLDER
}

enum LearnerNotificationType {
  ENROLLMENT_CONFIRMATION
  COURSE_REMINDER
  INACTIVITY_REMINDER
  PARTICIPATION_WARNING
  EXAM_UNLOCK
  EXAM_RESULT
  CERTIFICATE_ISSUED
  TRANSCRIPT_UPDATE
  ADMIN_ANNOUNCEMENT
  CMS_PUBLISH
  COMMUNITY_PLACEHOLDER
  LEARNER_NOTICE
  COURSE_UPDATE
  REFERRAL_USED
  REFERRAL_CONVERTED
  COHORT_MESSAGING_PLACEHOLDER
}

enum ReminderType {
  UNFINISHED_COURSE
  INACTIVITY
  INCOMPLETE_ATTESTATION
  PARTICIPATION_WARNING
  CERTIFICATE_READY
  EXPIRATION_PLACEHOLDER
  SUBSCRIPTION_RENEWAL_PLACEHOLDER
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  SKIPPED
}

enum AnnouncementAudience {
  ALL_LEARNERS
  COURSE_ENROLLMENTS
  COHORT_PLACEHOLDER
}

enum GamificationEventType {
  POINTS_AWARDED
  BADGE_EARNED
  STREAK_UPDATED
  LEVEL_UP
  CUSTOM
}

enum CourseMilestoneBadge {
  COURSES_3
  COURSES_6
  COURSES_9
  COURSES_12
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  ISSUE_CERTIFICATE
  OTHER
}

enum DeliveryMode {
  ONLINE
  IN_PERSON
  BLENDED
  OTHER
}

// =============================================================================
// Tenancy
// =============================================================================

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  settings  Json         @default("{}")
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  domains                 Domain[]
  users                   User[]
  roles                   Role[]
  courseCategories        CourseCategory[]
  courses                 Course[]
  mediaAssets             MediaAsset[]
  providerApprovals       ProviderApproval[]
  complianceRuleSets      ComplianceRuleSet[]
  enrollments             Enrollment[]
  orders                  Order[]
  billingCustomers        BillingCustomer[]
  subscriptions           Subscription[]
  supportTickets          SupportTicket[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  scheduledReminders      ScheduledReminder[]
  announcements           Announcement[]
  gamificationEvents      GamificationEvent[]
  userBadges              UserBadge[]
  auditLogs               AuditLog[]
  aiGenerationJobs        AiGenerationJob[]
  referrals               Referral[]
  referralRewards         ReferralReward[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model Domain {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  hostname   String     @unique
  kind       DomainKind @default(PRIMARY)
  isVerified Boolean    @default(false) @map("is_verified")
  isPrimary  Boolean    @default(false) @map("is_primary")
  metadata   Json       @default("{}")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([deletedAt])
  @@map("domains")
}

// =============================================================================
// Identity & RBAC
// =============================================================================

model User {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  email            String
  passwordHash     String?    @map("password_hash")
  firstName        String?    @map("first_name")
  lastName         String?    @map("last_name")
  status           UserStatus @default(INVITED)
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  termsAcceptedAt  DateTime?  @map("terms_accepted_at")
  lastLoginAt      DateTime?  @map("last_login_at")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  referralCode     String     @unique @map("referral_code") @db.Char(8)
  referredByCode   String?    @map("referred_by_code") @db.Char(8)
  metadata         Json       @default("{}")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learnerProfile          LearnerProfile?
  userRoles               UserRole[]
  professionalCredentials ProfessionalCredential[]
  enrollments             Enrollment[]
  lessonProgress          LessonProgress[]
  assessmentAttempts      AssessmentAttempt[]
  completions             Completion[]
  certificates            Certificate[]
  transcriptEntries       TranscriptEntry[]
  renewalPeriods          RenewalPeriod[]
  complianceSnapshots     ComplianceSnapshot[]
  orders                  Order[]
  billingCustomer         BillingCustomer?
  subscriptions           Subscription[]
  supportTickets          SupportTicket[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  scheduledReminders      ScheduledReminder[]
  announcementsAuthored   Announcement[]           @relation("AnnouncementAuthor")
  gamificationEvents      GamificationEvent[]
  userBadges              UserBadge[]
  auditLogs               AuditLog[]
  aiGenerationJobs        AiGenerationJob[]        @relation("AiJobRequestedBy")
  refreshSessions         RefreshSession[]
  authTokens              AuthToken[]
  referralsAsReferrer     Referral[]       @relation("ReferralsAsReferrer")
  referralsAsReferree     Referral?        @relation("ReferralsAsReferree")
  referralRewards         ReferralReward[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("users")
}

model LearnerProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  tenantId           String    @map("tenant_id")
  jurisdictionId     String?   @map("jurisdiction_id")
  professionId       String?   @map("profession_id")
  licenseNumber      String?   @map("license_number")
  licenseExpiresOn   DateTime? @map("license_expires_on") @db.Date
  licenseEffectiveOn DateTime? @map("license_effective_on") @db.Date
  birthMonth         Int?      @map("birth_month")
  birthDay           Int?      @map("birth_day")
  city               String?   @map("city")
  /// null = never chose (UI defaults checked); true = consented; false = withdrew
  cityConsentGiven   Boolean?  @map("city_consent_given")
  cityConsentGivenAt DateTime? @map("city_consent_given_at")
  preferredLanguage  String?   @default("en") @map("preferred_language")
  timezone           String?   @default("America/Los_Angeles")
  onboardingComplete Boolean   @default(false) @map("onboarding_complete")
  profileData        Json      @default("{}") @map("profile_data")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jurisdiction Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  profession   Profession?   @relation(fields: [professionId], references: [id])

  @@index([tenantId])
  @@index([jurisdictionId, professionId])
  @@index([deletedAt])
  @@map("learner_profiles")
}

model Role {
  id          String    @id @default(cuid())
  tenantId    String?   @map("tenant_id")
  slug        String
  name        String
  description String?
  scope       RoleScope @default(TENANT)
  isSystem    Boolean   @default(false) @map("is_system")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([scope])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  tenantId  String   @map("tenant_id")
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model AuthToken {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuthLoginAttempt {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  email     String
  ipAddress String?  @map("ip_address")
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("auth_login_attempts")
}

// =============================================================================
// Regulatory & credentials
// =============================================================================

model Jurisdiction {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  country   String    @default("US")
  region    String?
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  learnerProfiles         LearnerProfile[]
  professions             Profession[]
  professionalCredentials ProfessionalCredential[]
  providerApprovals       ProviderApproval[]
  complianceRuleSets      ComplianceRuleSet[]
  complianceSnapshots     ComplianceSnapshot[]

  @@index([deletedAt])
  @@map("jurisdictions")
}

model Profession {
  id             String    @id @default(cuid())
  jurisdictionId String    @map("jurisdiction_id")
  code           String
  name           String
  description    String?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  jurisdiction            Jurisdiction             @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  learnerProfiles         LearnerProfile[]
  professionalCredentials ProfessionalCredential[]
  providerApprovals       ProviderApproval[]
  complianceRuleSets      ComplianceRuleSet[]
  courses                 Course[]

  @@unique([jurisdictionId, code])
  @@index([deletedAt])
  @@map("professions")
}

model ProfessionalCredential {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  professionId   String           @map("profession_id")
  jurisdictionId String           @map("jurisdiction_id")
  licenseNumber  String           @map("license_number")
  status         CredentialStatus @default(PENDING)
  issuedOn       DateTime?        @map("issued_on") @db.Date
  expiresOn      DateTime?        @map("expires_on") @db.Date
  verifiedAt     DateTime?        @map("verified_at")
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession   Profession   @relation(fields: [professionId], references: [id], onDelete: Cascade)
  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([licenseNumber])
  @@index([deletedAt])
  @@map("professional_credentials")
}

model ProviderApproval {
  id              String                 @id @default(cuid())
  tenantId        String                 @map("tenant_id")
  jurisdictionId  String                 @map("jurisdiction_id")
  professionId    String?                @map("profession_id")
  approvingBody   String                 @map("approving_body")
  approvalNumber  String?                @map("approval_number")
  status          ProviderApprovalStatus @default(PENDING)
  effectiveFrom   DateTime?              @map("effective_from") @db.Date
  effectiveTo     DateTime?              @map("effective_to") @db.Date
  ceHoursApproved Decimal?               @map("ce_hours_approved") @db.Decimal(8, 2)
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  deletedAt       DateTime?              @map("deleted_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  profession   Profession?  @relation(fields: [professionId], references: [id])

  @@index([tenantId, status])
  @@index([jurisdictionId, professionId])
  @@index([deletedAt])
  @@map("provider_approvals")
}

// =============================================================================
// Course catalog & content
// =============================================================================

model CourseCategory {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  slug        String
  name        String
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder])
  @@index([deletedAt])
  @@map("course_categories")
}

model Course {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  categoryId   String?      @map("category_id")
  professionId String?      @map("profession_id")
  slug         String
  title        String
  summary      String?
  status       CourseStatus @default(DRAFT)
  ceHours      Decimal      @default(1) @map("ce_hours") @db.Decimal(8, 2)
  catalogData  Json         @default("{}") @map("catalog_data")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      CourseCategory? @relation(fields: [categoryId], references: [id])
  profession    Profession?     @relation(fields: [professionId], references: [id])
  versions      CourseVersion[]
  announcements Announcement[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("courses")
}

model CourseVersion {
  id            String              @id @default(cuid())
  courseId      String              @map("course_id")
  versionNumber Int                 @map("version_number")
  label         String?
  status        CourseVersionStatus @default(DRAFT)
  ceHours       Decimal             @map("ce_hours") @db.Decimal(8, 2)
  deliveryMode  DeliveryMode        @default(ONLINE) @map("delivery_mode")
  publishedAt   DateTime?           @map("published_at")
  contentMeta   Json                @default("{}") @map("content_meta")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules     Module[]
  assessments Assessment[]
  enrollments Enrollment[]
  completions Completion[]

  @@unique([courseId, versionNumber])
  @@index([courseId, status])
  @@index([deletedAt])
  @@map("course_versions")
}

model Module {
  id              String               @id @default(cuid())
  courseVersionId String               @map("course_version_id")
  slug            String
  title           String
  description     String?
  sortOrder       Int                  @default(0) @map("sort_order")
  status          ContentPublishStatus @default(DRAFT)
  ceHours         Decimal              @default(0) @map("ce_hours") @db.Decimal(8, 2)
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  courseVersion CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  assessments   Assessment[]

  @@unique([courseVersionId, slug])
  @@index([courseVersionId, sortOrder])
  @@index([deletedAt])
  @@map("modules")
}

model Lesson {
  id              String               @id @default(cuid())
  moduleId        String               @map("module_id")
  slug            String
  title           String
  description     String?
  sortOrder       Int                  @default(0) @map("sort_order")
  status          ContentPublishStatus @default(DRAFT)
  ceHours         Decimal              @default(0) @map("ce_hours") @db.Decimal(8, 2)
  durationMinutes Int?                 @map("duration_minutes")
  content         Json                 @default("{}")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  mediaAssets    MediaAsset[]
  lessonProgress LessonProgress[]
  assessments    Assessment[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@index([deletedAt])
  @@map("lessons")
}

model MediaAsset {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  lessonId    String?          @map("lesson_id")
  type        MediaAssetType
  status      MediaAssetStatus @default(PENDING)
  title       String?
  storageKey  String           @map("storage_key")
  mimeType    String?          @map("mime_type")
  byteSize    BigInt?          @map("byte_size")
  durationSec Int?             @map("duration_sec")
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id])

  @@index([tenantId, type])
  @@index([lessonId])
  @@index([deletedAt])
  @@map("media_assets")
}

model Assessment {
  id                String         @id @default(cuid())
  courseVersionId   String?        @map("course_version_id")
  moduleId          String?        @map("module_id")
  lessonId          String?        @map("lesson_id")
  slug              String
  title             String
  kind              AssessmentKind @default(QUIZ)
  passingScore      Decimal?       @map("passing_score") @db.Decimal(5, 2)
  maxAttempts       Int?           @map("max_attempts")
  timeLimitMin      Int?           @map("time_limit_min")
  settings          Json           @default("{}")
