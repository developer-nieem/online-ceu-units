// =============================================================================
// Learning progress & outcomes
// =============================================================================

model Enrollment {
  id                         String           @id @default(cuid())
  tenantId                   String           @map("tenant_id")
  userId                     String           @map("user_id")
  courseVersionId            String           @map("course_version_id")
  status                     EnrollmentStatus @default(PENDING)
  enrolledAt                 DateTime         @default(now()) @map("enrolled_at")
  startedAt                  DateTime?        @map("started_at")
  completedAt                DateTime?        @map("completed_at")
  expiresAt                  DateTime?        @map("expires_at")
  /// CDPH online CE: server-tracked active participation seconds (denormalized from metadata.participation.ledger).
  activeParticipationSeconds Int              @default(0) @map("active_participation_seconds")
  /// Course attempts consumed for this enrollment (final exam submissions). Max 3 before repurchase.
  attemptsUsed               Int              @default(0) @map("attempts_used")
  metadata                   Json             @default("{}")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")
  deletedAt                  DateTime?        @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseVersion      CourseVersion       @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  lessonProgress     LessonProgress[]
  assessmentAttempts AssessmentAttempt[]
  completions        Completion[]

  @@unique([userId, courseVersionId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([deletedAt])
  @@map("enrollments")
}

model LessonProgress {
  id           String               @id @default(cuid())
  enrollmentId String               @map("enrollment_id")
  lessonId     String               @map("lesson_id")
  userId       String               @map("user_id")
  status       LessonProgressStatus @default(NOT_STARTED)
  progressPct  Decimal              @default(0) @map("progress_pct") @db.Decimal(5, 2)
  startedAt    DateTime?            @map("started_at")
  completedAt  DateTime?            @map("completed_at")
  lastPosition Json?                @map("last_position")
  metadata     Json                 @default("{}")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([userId, status])
  @@map("lesson_progress")
}

model AssessmentAttempt {
  id           String                  @id @default(cuid())
  enrollmentId String                  @map("enrollment_id")
  assessmentId String                  @map("assessment_id")
  userId       String                  @map("user_id")
  attemptNum   Int                     @default(1) @map("attempt_num")
  status       AssessmentAttemptStatus @default(IN_PROGRESS)
  score        Decimal?                @db.Decimal(5, 2)
  responses    Json                    @default("{}")
  startedAt    DateTime                @default(now()) @map("started_at")
  submittedAt  DateTime?               @map("submitted_at")
  gradedAt     DateTime?               @map("graded_at")
  metadata     Json                    @default("{}")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  enrollment   Enrollment                   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assessment   Assessment                   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  violations   AssessmentAttemptViolation[]
  certificates Certificate[]

  @@unique([enrollmentId, assessmentId, attemptNum])
  @@index([userId, status])
  @@map("assessment_attempts")
}

model AssessmentAttemptViolation {
  id         String   @id @default(cuid())
  attemptId  String   @map("attempt_id")
  type       String
  occurredAt DateTime @default(now()) @map("occurred_at")
  durationMs Int?     @map("duration_ms")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@map("assessment_attempt_violations")
}

model Completion {
  id              String           @id @default(cuid())
  enrollmentId    String           @unique @map("enrollment_id")
  userId          String           @map("user_id")
  courseVersionId String           @map("course_version_id")
  status          CompletionStatus @default(PENDING)
  ceHoursEarned   Decimal          @map("ce_hours_earned") @db.Decimal(8, 2)
  completedAt     DateTime         @default(now()) @map("completed_at")
  approvedAt      DateTime?        @map("approved_at")
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseVersion     CourseVersion     @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  certificate       Certificate?
  transcriptEntries TranscriptEntry[]

  @@index([userId, completedAt])
  @@index([courseVersionId])
  @@map("completions")
}

model Certificate {
  id            String            @id @default(cuid())
  completionId  String            @unique @map("completion_id")
  userId        String            @map("user_id")
  certificateNo String            @unique @map("certificate_no")
  status        CertificateStatus @default(PENDING)
  issuedAt      DateTime?         @map("issued_at")
  expiresAt     DateTime?         @map("expires_at")
  payload       Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  revokedAt     DateTime?         @map("revoked_at")
  revokeReason  String?           @map("revoke_reason")
  attemptId     String?           @map("attempt_id")

  completion        Completion                    @relation(fields: [completionId], references: [id], onDelete: Cascade)
  user              User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationToken CertificateVerificationToken?
  attempt           AssessmentAttempt?            @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("certificates")
}

model CertificateVerificationToken {
  id            String                  @id @default(cuid())
  certificateId String                  @unique @map("certificate_id")
  token         String                  @unique
  status        VerificationTokenStatus @default(ACTIVE)
  expiresAt     DateTime?               @map("expires_at")
  revokedAt     DateTime?               @map("revoked_at")
  auditLogId    String?                 @map("audit_log_id")
  metadata      Json                    @default("{}")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([token, status])
  @@map("certificate_verification_tokens")
}

model TranscriptEntry {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  completionId String?             @map("completion_id")
  entryType    TranscriptEntryType @map("entry_type")
  title        String
  ceHours      Decimal             @map("ce_hours") @db.Decimal(8, 2)
