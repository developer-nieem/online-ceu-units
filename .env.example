# =============================================================================
# CAL ACE Nursing Academy — Monorepo environment template
# Copy to .env at the repository root (never commit .env)
# See docs/ENVIRONMENT.md for loading order and per-app overrides.
# =============================================================================

NODE_ENV=development

# --- PostgreSQL (Docker Compose defaults) ---
POSTGRES_USER=calace
POSTGRES_PASSWORD=calace_dev
POSTGRES_DB=calace_lms
POSTGRES_PORT=5432

# --- Prisma / @calace/db ---
DATABASE_URL="postgresql://calace:calace_dev@localhost:5432/calace_lms?schema=public"
DIRECT_URL="postgresql://calace:calace_dev@localhost:5432/calace_lms?schema=public"

# Writes known development staff/demo passwords (dev login) into the seeded DB.
# Fail-closed: dev passwords are written ONLY when this is exactly "true".
# Set to "true" ONLY in a local/dev environment you control. NEVER set in production.
SEED_DEV_PASSWORDS=false

# --- API (@calace/api) ---
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
DEFAULT_TENANT_SLUG=cal-ace

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=change-me-to-a-32-char-minimum-secret-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public self-service signup. Fail-closed: signup is BLOCKED unless this is exactly "true".
# Leave unset/false in production until public registration is intentionally launched.
SIGNUP_ENABLED=false

# CAPTCHA: none | turnstile | recaptcha (none allowed in development only)
CAPTCHA_PROVIDER=none
TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=

# --- Transactional email (SMTP) — optional in development ---
# When unset, verification and other auth emails are logged (API does not crash).
# SMTP_FROM defaults to Online CE Units - CAL ACE <support@onlineceunits.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Online CE Units - CAL ACE <support@onlineceunits.com>

# --- Stripe (Test Mode — create products/prices in Stripe Dashboard) ---
# Leave placeholder values to keep mock checkout; replace with sk_test_*, whsec_*, price_* from Stripe.
# Create recurring prices for unlimited plans (subscription mode) and one-time for single course.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Test mode price IDs ($3.75 single | $19.50 1-Year Unlimited | $37.50 2-Year Unlimited)
STRIPE_PRICE_SINGLE=price_replace_single
STRIPE_PRICE_UNLIMITED_1Y=price_replace_unlimited_1y
STRIPE_PRICE_UNLIMITED_2Y=price_replace_unlimited_2y
# Live mode price IDs (used automatically when STRIPE_SECRET_KEY starts with sk_live_)
STRIPE_PRICE_SINGLE_LIVE=price_replace_single_live
STRIPE_PRICE_UNLIMITED_1Y_LIVE=price_replace_unlimited_1y_live
STRIPE_PRICE_UNLIMITED_2Y_LIVE=price_replace_unlimited_2y_live

# --- Web (@calace/web) — browser uses /api rewrite; server uses INTERNAL_API_URL ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
