# Railway API image — API + workspace packages only (not Next.js web).

FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

# Manifests + db generate scripts first (root postinstall needs these)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json tsconfig.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/db/package.json ./packages/db/
COPY packages/db/prisma ./packages/db/prisma
COPY packages/db/scripts ./packages/db/scripts
COPY packages/compliance/package.json ./packages/compliance/
COPY packages/content-blocks/package.json ./packages/content-blocks/
COPY packages/ai-course-generation/package.json ./packages/ai-course-generation/
COPY packages/notifications-engine/package.json ./packages/notifications-engine/
COPY packages/typescript-config ./packages/typescript-config
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/ui/package.json ./packages/ui/

# Full install so bcrypt native bindings + prisma generate postinstall both run
ENV CI=true
ENV NODE_ENV=development
RUN pnpm install --frozen-lockfile --filter=@calace/api...

COPY apps/api ./apps/api
COPY packages ./packages

RUN pnpm turbo run build --filter=@calace/api --ui=stream

ENV NODE_ENV=production
EXPOSE 3001

CMD ["node", "apps/api/dist/main.js"]
