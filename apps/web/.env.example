# Public (exposed to the browser — must use NEXT_PUBLIC_ prefix)
# Browser client calls use same-origin /api/* (Next.js rewrite). Server-side fetch uses this URL.
NEXT_PUBLIC_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# CAPTCHA: none | turnstile | recaptcha
NEXT_PUBLIC_CAPTCHA_PROVIDER=none
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Server-only (Next.js server components / route handlers)
# Stripe — omit for demo checkout mode (simulated payments, no real charges)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
