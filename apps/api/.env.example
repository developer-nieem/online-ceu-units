# ============================================================
# CAL ACE API — Environment Variable Template
# Copy to .env and fill in real values. NEVER put real secrets in this file.
# This file is tracked in git — placeholders only.
# ============================================================

# --- AI Course Generation ---
AI_COURSE_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- API Server ---
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
DEFAULT_TENANT_SLUG=cal-ace

# --- Auth / JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Captcha ---
CAPTCHA_PROVIDER=none
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key

# --- Stripe (test) ---
STRIPE_SECRET_KEY=replace-with-stripe-test-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-test-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_SINGLE=replace-with-stripe-price-id
STRIPE_PRICE_UNLIMITED_1Y=replace-with-stripe-price-id
STRIPE_PRICE_UNLIMITED_2Y=replace-with-stripe-price-id

# --- Stripe (live) ---
STRIPE_PRICE_SINGLE_LIVE=replace-with-stripe-live-price-id
STRIPE_PRICE_UNLIMITED_1Y_LIVE=replace-with-stripe-live-price-id
STRIPE_PRICE_UNLIMITED_2Y_LIVE=replace-with-stripe-live-price-id

# --- Email / SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require
